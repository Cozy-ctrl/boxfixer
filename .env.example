# Required platform keys
UPSTASH_BOX_API_KEY=
ONE_API_KEY=

# One CLI GitHub connection and action key
ONE_GITHUB_CONNECTION_KEY=live::github::default::your-connection-id
ONE_GITHUB_ACTION_KEY=

# GitHub repository target for issue creation
GITHUB_OWNER=Cozy-ctrl
GITHUB_REPO_NAME=boxfixer

# Safety switch: keep true until ready for live code changes
BOXFIXER_DRY_RUN=true
