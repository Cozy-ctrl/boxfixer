# Required platform keys
UPSTASH_BOX_API_KEY=
GITHUB_REPO=https://github.com/Cozy-ctrl/boxfixer.git
GITHUB_TARGET_BRANCH=main
BOX_AGENT_MODEL=anthropic/claude-sonnet-4-5

# Required One CLI configuration
ONE_API_KEY=
ONE_GITHUB_CONNECTION_KEY=live::github::default::your-connection-id
ONE_GITHUB_CREATE_ISSUE_ACTION_ID=

# GitHub repository target for issue creation
GITHUB_OWNER=Cozy-ctrl
GITHUB_REPO_NAME=boxfixer

# Set false for real execution
BOXFIXER_DRY_RUN=false
